# /etc/scada/scada.env — общие параметры обеих служб (права 640, владелец root:scada)

# Подключение к PostgreSQL (учётная запись приложения, см. db/003_app_role.sql)
ConnectionStrings__Scada=Host=localhost;Port=5432;Database=scada;Username=scada_app;Password=CHANGE_ME

# --- веб-приложение ---
Kestrel__Endpoints__Http__Url=http://0.0.0.0:8080
# Пароль администратора, создаваемого при первом запуске (пустая таблица users). Сменить при первом входе.
Scada__InitialAdminPassword=CHANGE_ME_NOW
# Срок жизни команды управления, с
Commands__TtlSeconds=15
# Критичные команды: second_user — второй пользователь подтверждает за ConfirmSeconds;
# permit — объект с одним дежурным: повторный пароль + номер наряда
Commands__CriticalConfirmMode=second_user
Commands__ConfirmSeconds=60

# Active Directory (только LDAPS). Без этого блока работают локальные учётные записи.
#Directory__Enabled=true
#Directory__Servers__0=dc1.vodokanal.local
#Directory__Servers__1=dc2.vodokanal.local
#Directory__Port=636
#Directory__BaseDn=DC=vodokanal,DC=local
#Directory__BindDn=CN=svc-scada,OU=Service,DC=vodokanal,DC=local
#Directory__BindPassword=CHANGE_ME
#Directory__RefreshMinutes=15
#Directory__OfflineGraceHours=8

# --- служба сбора ---
Acquisition__SpoolPath=/var/lib/scada/spool
Acquisition__SpoolMaxMb=1024
Acquisition__HistoryRetentionDays=90
Acquisition__PublishIntervalMs=250

# Каталог сертификатов OPC UA задаётся в параметрах устройства: {"pkiPath": "/var/lib/scada/pki"}

# Сбор мусора: рабочая станция, низкие паузы
DOTNET_gcServer=0
