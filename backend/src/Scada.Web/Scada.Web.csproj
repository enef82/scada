<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Веб-приложение: REST API, SignalR, аутентификация, раздача собранного фронтенда из wwwroot. -->
  <PropertyGroup>
    <AssemblyName>scada-web</AssemblyName>
    <RootNamespace>Scada.Web</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.0" />
    <!-- LDAPS к Active Directory; на Linux нужна libldap (пакет libldap-2.5-0 / openldap-libs) -->
    <PackageReference Include="System.DirectoryServices.Protocols" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Scada.Core\Scada.Core.csproj" />
    <ProjectReference Include="..\Scada.Drivers\Scada.Drivers.csproj" />
  </ItemGroup>
</Project>
