{
  "ConnectionStrings": {
    "Scada": "Host=localhost;Port=5432;Database=scada;Username=scada;Password=scada"
  },
  "Scada": {
    "InitialAdminPassword": "admin12345"
  },
  "Commands": {
    "TtlSeconds": 15,
    "WaitSeconds": 20,
    "AcquisitionStaleSeconds": 20,
    "ConfirmSeconds": 60,
    "CriticalConfirmMode": "second_user"
  },
  "Directory": {
    "Enabled": false,
    "Servers": [ "dc1.example.local", "dc2.example.local" ],
    "Port": 636,
    "BaseDn": "DC=example,DC=local",
    "GroupBaseDn": "",
    "BindDn": "CN=svc-scada,OU=Service,DC=example,DC=local",
    "BindPassword": "",
    "NestedGroups": true,
    "RefreshMinutes": 15,
    "OfflineGraceHours": 8
  },
  "Publishing": {
    "FourEyes": false,
    "ArchiveRowsPerDayLimit": 100000000
  },
  "Realtime": {
    "FlushIntervalMs": 250
  },
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://0.0.0.0:8080" }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
